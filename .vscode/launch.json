{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pytest: Current File",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: All Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: All Tests with Allure",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v", "--alluredir=allure-results"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: Regression Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-m", "regression", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: Smoke Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-m", "smoke", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Pytest: Parallel (Auto)",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-n", "auto", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
